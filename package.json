{
  "name": "nestjs",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "build:scripts": "tsc -p tsconfig.scripts.json",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "prisma:generate": "pnpm prisma:generate:users && pnpm prisma:generate:orders",
    "prisma:generate:users": "prisma generate --schema src/users/infrastructure/prisma/schema.prisma",
    "prisma:generate:orders": "prisma generate --schema src/orders/infrastructure/prisma/schema.prisma",
    "prisma:migrate:users": "prisma migrate dev --schema src/users/infrastructure/prisma/schema.prisma",
    "prisma:migrate:orders": "prisma migrate dev --schema src/orders/infrastructure/prisma/schema.prisma",
    "generate:spec": "tsx ./scripts/cli.ts generate:spec",
    "validate:architecture": "tsx ./scripts/cli.ts validate:architecture",
    "validate:domain": "tsx ./scripts/cli.ts validate:domain",
    "check:domain-invariants": "tsx ./scripts/cli.ts check:domain-invariants",
    "check:dependencies": "tsx ./scripts/cli.ts check:dependencies",
    "test:contract": "tsx ./scripts/cli.ts test:contract",
    "report:microservice-health": "tsx ./scripts/cli.ts report:microservice-health",
    "enrich_us": "tsx ./scripts/cli.ts enrich_us",
    "propose": "tsx ./scripts/cli.ts propose",
    "apply": "tsx ./scripts/cli.ts apply",
    "verify": "tsx ./scripts/cli.ts verify",
    "code_review": "tsx ./scripts/cli.ts code_review",
    "archive": "tsx ./scripts/cli.ts archive",
    "commit_flow": "tsx ./scripts/cli.ts commit_flow",
    "publish": "tsx ./scripts/cli.ts publish"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@prisma/client": "^6.13.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "tsx": "^4.19.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "prisma": "^6.13.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
